{
  "name": "seo-auditor",
  "version": "0.7.0-dev.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev:prepare": "pnpm --filter './packages/*' build",
    "dev": "pnpm dev:prepare && pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter './packages/*' build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @seo-auditor/database db:generate",
    "db:migrate": "pnpm --filter @seo-auditor/database db:migrate",
    "db:studio": "pnpm --filter @seo-auditor/database exec prisma studio",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps"
  },
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": ">=10.18.0 <11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.1"
  }
}
