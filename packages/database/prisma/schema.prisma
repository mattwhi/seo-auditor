generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  baseUrl   String
  createdAt     DateTime @default(now())
  retentionDays Int      @default(90)

  audits   Audit[]
  schedule AuditSchedule?
}

model Audit {
  id          String    @id @default(cuid())
  projectId   String
  status      String    @default("queued")
  score       Int?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  trigger     String    @default("manual")
  cancelRequested Boolean @default(false)

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages         Page[]
  issues        Issue[]
  crawlFailures CrawlFailure[]
  performanceResults PerformanceResult[]

  @@index([projectId])
  @@index([projectId, createdAt])
  @@index([status])
  @@index([createdAt])
}

model Page {
  id              String  @id @default(cuid())
  auditId         String
  url             String
  finalUrl        String
  statusCode      Int
  responseTimeMs  Int
  title           String?
  metaDescription String?
  canonical       String?
  robots          String[]
  h1              String[]
  h2              String[]
  wordCount       Int
  schemaTypes     String[]
  images          Json?
  outgoingLinks   Json?
  hreflang        Json?
  jsonLdBlocks    Int     @default(0)
  jsonLdErrors    Int     @default(0)
  contentHash     String?
  redirectChain   Json?
  contentType     String?
  contentLength   Int?
  contentEncoding String?
  contentLanguage String?
  cacheControl    String?
  etag            String?
  lastModified    String?
  xRobotsTag      String[]
  crawlDepth      Int?
  redirectCount   Int?
  fetchAttempts   Int?

  audit  Audit   @relation(fields: [auditId], references: [id], onDelete: Cascade)
  issues Issue[]

  @@unique([auditId, url])
  @@index([auditId])
  @@index([statusCode])
  @@index([auditId, crawlDepth])
  @@index([auditId, contentHash])
}

model Issue {
  id       String  @id @default(cuid())
  auditId  String
  pageId   String?
  ruleId   String
  severity String
  category String
  message  String
  evidence Json?

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  page  Page? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([pageId])
  @@index([auditId, ruleId])
  @@index([severity])
}

model CrawlFailure {
  id         String   @id @default(cuid())
  auditId    String
  url        String
  type       String
  message    String
  statusCode Int?
  attempts   Int
  redirectChain Json?
  createdAt  DateTime @default(now())

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([auditId, type])
  @@index([statusCode])
}

model AuditSchedule {
  id        String   @id @default(cuid())
  projectId String   @unique
  enabled   Boolean  @default(false)
  frequency String   @default("weekly")
  hourUtc   Int      @default(3)
  dayOfWeek Int?
  dayOfMonth Int?
  nextRunAt DateTime?
  lastRunAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
}

// v0.6: Performance data is independent of the technical SEO score.
model PerformanceResult {
  id String @id @default(cuid())
  auditId String
  strategy String
  pageType String @default("homepage")
  url String
  status String
  measuredAt DateTime @default(now())
  lighthouseScore Int?
  metrics Json
  error String?

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  @@unique([auditId, strategy, url])
  @@index([auditId])
}


/// v0.8.2 operator-reviewed remediation proposals. No live WordPress writes.
model RemediationProposal {
  id           String   @id @default(cuid())
  auditId      String
  issueId      String
  projectId    String
  pageUrl      String
  ruleId       String
  targetType   String
  targetId     Int
  proposedText String   @db.Text
  status       String   @default("draft")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  approvedAt   DateTime?
  rejectedAt   DateTime?
  @@index([projectId, createdAt])
  @@index([auditId, issueId])
  @@index([status])
}


/// v0.8.3 immutable read-only preflight history; no execution credentials or write APIs.
model RemediationPreflight {
  id            String   @id @default(cuid())
  proposalId    String
  snapshotHash  String
  adapter       String
  field         String
  originalValue String   @db.Text
  conflict      Boolean  @default(false)
  createdAt     DateTime @default(now())
  @@index([proposalId, createdAt])
}
