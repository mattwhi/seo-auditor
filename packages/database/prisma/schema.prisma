generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            String   @id @default(cuid())
  name          String
  baseUrl       String
  createdAt     DateTime @default(now())
  retentionDays Int      @default(90)

  audits      Audit[]
  schedule    AuditSchedule?
  integration ProjectIntegration?
  aiSettings  ProjectAiSettings?
  aiAnalyses  AiAnalysis[]
  aiReviews   AiRemediationReview[]
  competitors IntelligenceCompetitor[]
  keywordObservations IntelligenceKeywordObservation[]
  opportunities IntelligenceOpportunity[]
  serpObservations IntelligenceSerpObservation[]
}

model Audit {
  id              String    @id @default(cuid())
  projectId       String
  status          String    @default("queued")
  score           Int?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  trigger         String    @default("manual")
  cancelRequested Boolean   @default(false)

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages              Page[]
  issues             Issue[]
  crawlFailures      CrawlFailure[]
  performanceResults PerformanceResult[]
  aiAnalyses         AiAnalysis[]

  @@index([projectId])
  @@index([projectId, createdAt])
  @@index([status])
  @@index([createdAt])
}

model Page {
  id              String   @id @default(cuid())
  auditId         String
  url             String
  finalUrl        String
  statusCode      Int
  responseTimeMs  Int
  title           String?
  metaDescription String?
  canonical       String?
  robots          String[]
  h1              String[]
  h2              String[]
  wordCount       Int
  schemaTypes     String[]
  images          Json?
  outgoingLinks   Json?
  hreflang        Json?
  jsonLdBlocks    Int      @default(0)
  jsonLdErrors    Int      @default(0)
  contentHash     String?
  redirectChain   Json?
  contentType     String?
  contentLength   Int?
  contentEncoding String?
  contentLanguage String?
  cacheControl    String?
  etag            String?
  lastModified    String?
  xRobotsTag      String[]
  crawlDepth      Int?
  redirectCount   Int?
  fetchAttempts   Int?

  audit      Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)
  issues     Issue[]
  aiAnalyses AiAnalysis[]

  @@unique([auditId, url])
  @@index([auditId])
  @@index([statusCode])
  @@index([auditId, crawlDepth])
  @@index([auditId, contentHash])
}

model Issue {
  id       String  @id @default(cuid())
  auditId  String
  pageId   String?
  ruleId   String
  severity String
  category String
  message  String
  evidence Json?

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  page  Page? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([pageId])
  @@index([auditId, ruleId])
  @@index([severity])
}

model CrawlFailure {
  id            String   @id @default(cuid())
  auditId       String
  url           String
  type          String
  message       String
  statusCode    Int?
  attempts      Int
  redirectChain Json?
  createdAt     DateTime @default(now())

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([auditId, type])
  @@index([statusCode])
}

model AuditSchedule {
  id         String    @id @default(cuid())
  projectId  String    @unique
  enabled    Boolean   @default(false)
  frequency  String    @default("weekly")
  hourUtc    Int       @default(3)
  dayOfWeek  Int?
  dayOfMonth Int?
  nextRunAt  DateTime?
  lastRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
}

// v0.6: Performance data is independent of the technical SEO score.
model PerformanceResult {
  id              String   @id @default(cuid())
  auditId         String
  strategy        String
  pageType        String   @default("homepage")
  url             String
  status          String
  measuredAt      DateTime @default(now())
  lighthouseScore Int?
  metrics         Json
  error           String?

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, strategy, url])
  @@index([auditId])
}

/// v0.8.2 operator-reviewed remediation proposals. No live WordPress writes.
model RemediationProposal {
  id           String    @id @default(cuid())
  auditId      String
  issueId      String
  projectId    String
  pageUrl      String
  ruleId       String
  targetType   String
  targetId     Int
  proposedText String    @db.Text
  status       String    @default("draft")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  approvedAt   DateTime?
  rejectedAt   DateTime?

  @@index([projectId, createdAt])
  @@index([auditId, issueId])
  @@index([status])
}

/// v0.8.3 immutable read-only preflight history; no execution credentials or write APIs.
model RemediationPreflight {
  id            String   @id @default(cuid())
  proposalId    String
  snapshotHash  String
  adapter       String
  field         String
  originalValue String   @db.Text
  conflict      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([proposalId, createdAt])
}

/// Durable execution/rollback record. Snapshots contain SEO text; keep DB access restricted.
model RemediationExecution {
  id            String    @id @default(cuid())
  proposalId    String    @unique
  preflightId   String
  projectId     String
  field         String
  originalValue String    @db.Text
  appliedValue  String    @db.Text
  snapshotHash  String
  status        String    @default("pending")
  errorCode     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  executedAt    DateTime?
  rolledBackAt  DateTime?

  @@index([projectId, createdAt])
  @@index([status])
}

// v1.1.0-alpha.1: invitation-only dashboard accounts.
model DashboardUser {
  id           String                @id @default(cuid())
  email        String                @unique
  passwordHash String
  role         String                @default("READ_ONLY")
  disabled     Boolean               @default(false)
  createdAt    DateTime              @default(now())
  sessions     DashboardSession[]
  invitations  DashboardInvitation[] @relation("InvitedBy")
  adminEvents  DashboardAdminEvent[] @relation("AdminActor")
}

model DashboardSession {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime      @default(now())
  user      DashboardUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model DashboardInvitation {
  id          String        @id @default(cuid())
  email       String
  role        String        @default("READ_ONLY")
  tokenHash   String        @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())
  invitedBy   DashboardUser @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([email])
  @@index([expiresAt])
}

// v1.1.0-alpha.2: immutable administration audit history.
model DashboardAdminEvent {
  id         String        @id @default(cuid())
  actorId    String
  action     String
  targetId   String
  details    Json?
  createdAt  DateTime      @default(now())
  archivedAt DateTime?
  actor      DashboardUser @relation("AdminActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([targetId, createdAt])
  @@index([archivedAt, createdAt])
}

/// v1.1.0-beta.1: administrator-controlled, default-deny WordPress write policy.
/// Infrastructure REMEDIATION_WRITES_ENABLED and origin allowlist remain mandatory.
model WordPressWritePolicy {
  projectId   String   @id
  enabled     Boolean  @default(false)
  updatedById String
  updatedAt   DateTime @updatedAt

  @@index([enabled])
}

/// Administrator-managed operational settings. Values are bounded and audited.
model ApplicationSetting {
  key         String   @id
  value       Json
  updatedById String
  updatedAt   DateTime @updatedAt
}

/// Non-secret integration mappings. Credentials remain mounted in API containers.
model ProjectIntegration {
  projectId            String   @id
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wordpressEnabled     Boolean  @default(false)
  wordpressSiteUrl     String?
  searchConsoleSiteUrl String?
  ga4PropertyId        String?
  updatedById          String
  updatedAt            DateTime @updatedAt
}

/// AES-256-GCM encrypted per-project WordPress Application Password.
/// Key is supplied at runtime; never persisted in the database.
model WordPressCredential {
  projectId         String   @id
  username          String
  encryptedPassword String   @db.Text
  updatedById       String
  updatedAt         DateTime @updatedAt
}

/// Encrypted per-project Google service account. Never return JSON/private key to clients.
model GoogleCredential {
  projectId     String   @id
  encryptedJson String   @db.Text
  accountEmail  String
  updatedById   String
  updatedAt     DateTime @updatedAt
}

// v0.9: AI is advisory only. Automatic mode is opt-in per project.
model ProjectAiSettings {
  projectId         String   @id
  enabled           Boolean  @default(false)
  mode              String   @default("manual")
  maxPagesPerAudit  Int      @default(3)
  maxAnalysesPerDay Int      @default(20)
  updatedAt         DateTime @updatedAt
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AiAnalysis {
  id                 String                @id @default(cuid())
  projectId          String
  auditId            String
  pageId             String
  contentFingerprint String
  trigger            String                @default("manual")
  model              String
  status             String                @default("running")
  summary            String?               @db.Text
  recommendations    Json?
  inputTokens        Int                   @default(0)
  outputTokens       Int                   @default(0)
  errorCode          String?
  createdAt          DateTime              @default(now())
  completedAt        DateTime?
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  audit              Audit                 @relation(fields: [auditId], references: [id], onDelete: Cascade)
  page               Page                  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  reviews            AiRemediationReview[]

  @@index([projectId, createdAt])
  @@index([auditId, pageId])
  @@index([projectId, status])
}

// v0.9.2: operator-reviewed AI suggestions. Approval never executes a live write.
model AiRemediationReview {
  id              String     @id @default(cuid())
  analysisId      String
  projectId       String
  suggestionIndex Int
  ruleId          String
  field           String
  priority        String
  currentValue    String     @db.Text
  proposedValue   String     @db.Text
  explanation     String     @db.Text
  evidence        String     @db.Text
  status          String     @default("pending")
  reviewerId      String?
  reviewedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  analysis        AiAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([analysisId, suggestionIndex])
  @@index([projectId, status])
}

// v1.2.0: Intelligence is advisory; none of these records authorise remediation.
model IntelligenceCompetitor {
  id        String   @id @default(cuid())
  projectId String
  domain    String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serpObservations IntelligenceSerpObservation[]

  @@unique([projectId, domain])
  @@index([projectId, createdAt])
}

model IntelligenceKeywordObservation {
  id          String   @id @default(cuid())
  projectId   String
  query       String
  pageUrl     String
  source      String   @default("search_console")
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  clicks      Int
  impressions Int
  ctr         Float
  position    Float
  observedAt  DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, source, query, pageUrl, periodStart, periodEnd])
  @@index([projectId, periodEnd])
  @@index([projectId, pageUrl])
}

model IntelligenceOpportunity {
  id             String    @id @default(cuid())
  projectId      String
  kind           String
  status         String    @default("open")
  pageUrl        String?
  keyword        String?
  title          String
  rationale      String    @db.Text
  evidence       Json
  evidenceSource String
  impact         Int
  confidence     Int
  effort         Int
  score          Int
  fingerprint    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, fingerprint])
  @@index([projectId, status, score])
  @@index([projectId, kind])
}

// v1.2.3: externally supplied SERP observations, never inferred from GSC.
model IntelligenceSerpObservation {
  id           String   @id @default(cuid())
  projectId    String
  competitorId String
  keyword      String
  position     Int
  resultUrl    String?
  source       String
  observedOn   DateTime @db.Date
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  competitor   IntelligenceCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([projectId, competitorId, keyword, source, observedOn])
  @@index([projectId, keyword])
  @@index([competitorId, observedOn])
}
